# API Key de Resend (https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Puerto en el que escucha el servicio
PORT=3000

# Remitente por defecto, usado cuando la petición no incluye `from`.
# OBLIGATORIO. El dominio debe estar verificado en tu cuenta de Resend,
# de lo contrario Resend rechazará todos los envíos.
DEFAULT_FROM=notificaciones@tu-dominio.com

# Dirección de respuesta por defecto (opcional).
# No requiere dominio verificado: sirve para que las respuestas lleguen
# a un buzón real aunque el remitente sea un no-reply.
DEFAULT_REPLY_TO=contacto@tu-dominio.com
